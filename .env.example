# Supabase — required once a project is provisioned
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical, OG, etc.)
NEXT_PUBLIC_SITE_URL=https://bazar-real-estate-cms.vercel.app

# CRON_SECRET — REQUIRED IN PRODUCTION. Every route under
# /api/cron/* (15 scheduled jobs incl. enquiry-auto-reply,
# enquiry-escalation, permit-expiry, saved-search-alerts, etc.)
# returns 503 when this is unset, silently breaking the lead funnel
# and all scheduled emails. Generate an opaque random token (e.g.
# `openssl rand -hex 32`) and set it in Vercel env. Vercel's cron
# runner automatically forwards it as `Authorization: Bearer <value>`
# to the paths listed in vercel.json.
CRON_SECRET=

# PostHog — optional, analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — optional, error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Resend — transactional email. If RESEND_API_KEY is missing, all email
# sends are skipped (the rest of the app keeps working). Get a key from
# https://resend.com/.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO=hello@bazar.ae

# Anthropic — powers the /concierge AI chat (Phase 5b). Read by
# lib/concierge/env.ts. If unset, /concierge falls back to a placeholder
# and the API route returns 503; the rest of the app is unaffected.
# Get a key from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# WhatsApp deep-link numbers used across /tools/mortgage,
# /admin/enquiries/[id], /contact, and /concierge handoffs. Both fall
# back to a placeholder so the buttons render in dev — set the real
# numbers in Vercel before launch. Free-form: "+971 50 …" works.
NEXT_PUBLIC_WHATSAPP_ADVISOR_NUMBER=
NEXT_PUBLIC_WHATSAPP_MORTGAGE_NUMBER=

# Upstash Redis — optional, per-IP rate limiting on public POST endpoints
# (/api/concierge, enquiry / valuation / newsletter forms). When BOTH
# are absent, the limiter silently no-ops — useful for local dev. Get
# REST URL + token from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sprint 12 integrations — all optional. Features degrade gracefully:
# search falls back to Postgres FTS, concierge falls back to FTS, the
# valuation address typeahead falls back to a plain text input, and
# maps fall back to maplibre-gl + open tiles.

# Meilisearch — search index + admin sync cron. Get keys from
# https://www.meilisearch.com/. MEILISEARCH_API_KEY is the admin key
# (server-only, used by /api/cron/meilisearch-sync). The search key
# below is public + scoped read-only.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
NEXT_PUBLIC_MEILISEARCH_HOST=
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# Voyage AI — embeddings for /concierge semantic_search. Server-only.
# Get a key from https://www.voyageai.com/.
VOYAGE_API_KEY=

# Mapbox — geocoding + directions + isochrone (commute-time tool).
# Get a public token from https://www.mapbox.com/.
NEXT_PUBLIC_MAPBOX_TOKEN=

# NEXT_PUBLIC_FX_USD_PER_AED — removed, do not set.
# The AED is pegged to the USD at 3.6725, so the rate is a constant in
# lib/preferences/rates.ts, not configuration. Setting this does nothing.
# See docs/decisions/ADR-0006-currency-aed-usd-only.md.

# Sprint 13 integrations — all optional. See docs/INTEGRATIONS.md for
# full onboarding instructions.

# Mailchimp newsletter sync (server-only).
# MAILCHIMP_DC is the datacenter slug at the end of your API key
# (e.g. "us21"). MAILCHIMP_WEBHOOK_SECRET is a random opaque token
# you generate; pass it as the ?secret= query param when configuring
# the Mailchimp webhook URL.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_DC=
MAILCHIMP_WEBHOOK_SECRET=

# DocuSign envelope creation + Connect webhook verification.
# Uses JWT impersonation flow. DOCUSIGN_PRIVATE_KEY should include the
# full PEM payload including -----BEGIN PRIVATE KEY----- headers.
# Use demo.docusign.net/restapi for sandbox, docusign.net/restapi for prod.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_WEBHOOK_SECRET=

# Property Finder + Bayut feed tokens. Each portal pulls
# /api/feeds/{property-finder,bayut}.xml?token=<...>. Set to a random
# opaque string per portal and share the URL+token via partner intake.
PROPERTY_FINDER_FEED_TOKEN=
BAYUT_FEED_TOKEN=

# Salesforce CRM — the lead push AND the listing sync share these. OAuth 2.0
# client-credentials flow; the connected app needs a "Run As" user with create
# and update on Lead__c and read on Property_Listing__c, Listing__c and their
# files. Leave blank and both /api/cron/salesforce-lead-sync and
# /api/cron/salesforce-listing-sync no-op, so dev, preview and CI are
# unaffected. A sandbox instance never publishes listings: the sync only
# evaluates them for the admin screen.
#
# SALESFORCE_INSTANCE_URL is the org's My Domain host with no trailing slash
# (sandbox looks like https://<org>--<sandbox>.sandbox.my.salesforce.com).
# Use the sandbox credentials for preview and a SEPARATE connected app for
# production — never the same secret in both.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Optional. Defaults to v67.0 / Lead__c when unset.
SALESFORCE_API_VERSION=
SALESFORCE_LEAD_OBJECT=

# Optional. Defaults to External_ID__c, which the 23 Sept 2026 revision of
# the vendor doc confirms exists on the object: Text(254), External ID,
# Unique. That default is what makes delivery exactly-once — the push PATCHes
# .../Lead__c/External_ID__c/<enquiry uuid>, so a retry after a network
# timeout updates the existing record instead of creating a duplicate lead.
# Only set this if the org renames the field.
SALESFORCE_LEAD_EXTERNAL_ID_FIELD=

# Blocks real email delivery. Leave it UNSET locally: outside production
# nothing sends by default, because .env.local carries a live Resend key and
# points at the production database — so curling a cron route from a laptop
# would otherwise read real recipients and mail them.
#
# Set to "false" when you genuinely want a live send from your machine (the
# "send me a test" button on /admin/content-assets). Set to "1" in Production
# to stop all outbound email during an incident.
EMAIL_DRY_RUN=

# Who receives the 07:00 health digest (errors + failing cron jobs).
# Comma-separated addresses. Unset = every active admin on the staff table.
# Set it to narrow the digest to the people actually on call.
HEALTH_DIGEST_RECIPIENTS=
