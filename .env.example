# Supabase — required once a project is provisioned
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical, OG, etc.)
NEXT_PUBLIC_SITE_URL=https://bazar-real-estate-cms.vercel.app

# PostHog — optional, analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — optional, error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Resend — transactional email. If RESEND_API_KEY is missing, all email
# sends are skipped (the rest of the app keeps working). Get a key from
# https://resend.com/.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO=hello@bazar.ae

# Anthropic — powers the /concierge AI chat (Phase 5b). Read by
# lib/concierge/env.ts. If unset, /concierge falls back to a placeholder
# and the API route returns 503; the rest of the app is unaffected.
# Get a key from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# WhatsApp deep-link numbers used across /tools/mortgage,
# /admin/enquiries/[id], /contact, and /concierge handoffs. Both fall
# back to a placeholder so the buttons render in dev — set the real
# numbers in Vercel before launch. Free-form: "+971 50 …" works.
NEXT_PUBLIC_WHATSAPP_ADVISOR_NUMBER=
NEXT_PUBLIC_WHATSAPP_MORTGAGE_NUMBER=

# Upstash Redis — optional, per-IP rate limiting on public POST endpoints
# (/api/concierge, enquiry / valuation / newsletter forms). When BOTH
# are absent, the limiter silently no-ops — useful for local dev. Get
# REST URL + token from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sprint 12 integrations — all optional. Features degrade gracefully:
# search falls back to Postgres FTS, concierge falls back to FTS, the
# valuation address typeahead falls back to a plain text input, and
# maps fall back to maplibre-gl + open tiles.

# Meilisearch — search index + admin sync cron. Get keys from
# https://www.meilisearch.com/. MEILISEARCH_API_KEY is the admin key
# (server-only, used by /api/cron/meilisearch-sync). The search key
# below is public + scoped read-only.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
NEXT_PUBLIC_MEILISEARCH_HOST=
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# Voyage AI — embeddings for /concierge semantic_search. Server-only.
# Get a key from https://www.voyageai.com/.
VOYAGE_API_KEY=

# Mapbox — geocoding + directions + isochrone (commute-time tool).
# Get a public token from https://www.mapbox.com/.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Static USD/AED rate placeholder. Used to render USD equivalents on
# /p/[slug] price block. Defaults to 0.272 when unset.
NEXT_PUBLIC_FX_USD_PER_AED=0.272
